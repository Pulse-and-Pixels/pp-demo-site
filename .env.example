# --- Sanity (public, safe to expose) ---------------------------------------
NUXT_PUBLIC_SANITY_PROJECT_ID=40bhay7m
NUXT_PUBLIC_SANITY_DATASET=production
# Keep in sync with pp-demo-studio/src/env.ts
NUXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Public URL of this website (canonical URLs, sitemap, Open Graph)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Visual editing / draft preview (server-side only) ----------------------
# A Sanity API token with the "Viewer" role. Never prefix with NUXT_PUBLIC_.
# Leave empty to build a public-only site without preview routes.
NUXT_SANITY_VISUAL_EDITING_TOKEN=

# URL of the Sanity Studio that hosts the Presentation tool
NUXT_SANITY_STUDIO_URL=http://localhost:3333
